# ==============================================================================
# FinTrack Backend Environment Configuration Template
# Salin berkas ini ke '.env' untuk lokal atau pasang di Environment Variables Cloud
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT SECRET ASLI KE GIT REPOSITORY
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Server
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development # Gunakan 'production' pada server hosting publik

# ------------------------------------------------------------------------------
# 2. Database Connection URL
# ------------------------------------------------------------------------------
# Default Lokal (SQLite):
DATABASE_URL="file:./dev.db"
#
# Opsi Produksi (Jika menggunakan PostgreSQL di Supabase/Neon/Railway):
# DATABASE_URL="postgresql://username:password@host:5432/fintrack_db?schema=public"
# Catatan: Jika menggunakan SQLite di produksi (Render/Railway), WAJIB menggunakan Persistent Disk/Volume!

# ------------------------------------------------------------------------------
# 3. Kredensial & Autentikasi JWT
# ------------------------------------------------------------------------------
# Kunci rahasia JWT wajib acak dan memiliki entropi tinggi minimal 32 karakter
# Generate contoh di terminal: openssl rand -base64 32
JWT_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_produksi
JWT_EXPIRES_IN=15m

# Masa aktif refresh token (dalam hari)
REFRESH_TOKEN_EXPIRES_DAYS=7

# ------------------------------------------------------------------------------
# 4. Kebijakan Keamanan Cookie (HttpOnly Session & CSRF)
# ------------------------------------------------------------------------------
# Nilai: 'lax', 'strict', atau 'none'
# - Jika Frontend dan Backend berada di domain/origin yang sama: 'strict' atau 'lax'
# - Jika Frontend dan Backend di domain berbeda (misal: vercel.app dan onrender.com): 'none' (wajib HTTPS)
COOKIE_SAME_SITE=lax

# Atribut Secure: 'true' untuk HTTPS di produksi, 'false' untuk HTTP lokal
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. Konfigurasi CORS & Keamanan Origin
# ------------------------------------------------------------------------------
# URL Frontend yang diizinkan mengakses API.
# Dapat dipisahkan dengan tanda koma jika memiliki lebih dari 1 domain (misal: production & staging)
CLIENT_URL="http://localhost:5173"
# Contoh Produksi:
# CLIENT_URL="https://fintrack.vercel.app,https://fintrack.mybrand.com"
