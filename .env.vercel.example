# ==============================================================================
# FinTrack — Template Environment Variables untuk 1 Project Terpadu di Vercel
# Masukkan nilai-nilai ini di: Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================================

# 1. Lingkungan Runtime (Wajib)
NODE_ENV=production

# 2. Database Connection URL (Wajib)
# Di Vercel Serverless, WAJIB menggunakan PostgreSQL Cloud (gratis via Neon.tech / Supabase / Railway)
# Contoh Neon / Supabase:
DATABASE_URL=postgresql://neondb_owner:password_anda@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Kredensial Enkripsi JWT (Wajib)
# Generate string acak 32+ karakter (Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=fintrack_super_secret_jwt_key_minimal_32_karakter_acak_1234567890

# 4. Kebijakan Keamanan Cookie Sesi (Rekomendasi untuk Vercel HTTPS)
# Karena Frontend & Backend berada di 1 domain yang sama, gunakan 'lax'
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# 5. Domain Aplikasi (Rekomendasi)
# Masukkan URL domain Vercel Anda (tanpa garis miring di akhir)
CLIENT_URL=https://nama-project-anda.vercel.app

# 6. URL API Frontend (Opsional - Kode api.js sudah otomatis mendeteksi /api)
VITE_API_URL=/api

# 7. Masa Berlaku Token (Opsional - Sudah ada default)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

