{
  "version": 2,
  "name": "fintrack",
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "fintrack/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/api",
      "dest": "backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "fintrack/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/favicon.svg",
      "dest": "fintrack/favicon.svg"
    },
    {
      "src": "/icons.svg",
      "dest": "fintrack/icons.svg"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "fintrack/index.html"
    }
  ]
}

